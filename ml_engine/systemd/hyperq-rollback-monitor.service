[Unit]
Description=HyperQ Rollback Monitor (6 Hours)
After=network.target

[Service]
Type=oneshot
User=vth
WorkingDirectory=/home/vth/Vth/ml_engine
Environment="PATH=/home/vth/Vth/ml_engine/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
ExecStart=/home/vth/Vth/ml_engine/venv/bin/python3 -m monitoring.rollback_daemon
TimeoutStartSec=21600
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
